<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <ProjectReference Include="../WebStore.Model/WebStore.Model.csproj" />
    <ProjectReference Include="../WebStore.DAL/WebStore.DAL.csproj" />
    <ProjectReference Include="../WebStore.ViewModels/WebStore.ViewModels.csproj" />
    <ProjectReference Include="../WebStore.Services/WebStore.Services.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <Target Name="RestoreClient" Inputs="ClientApp/package.json;ClientApp/package-lock.json" Outputs="ClientApp/node_modules/.package-lock.json" Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipClientBuild)' != 'true'">
    <Exec WorkingDirectory="ClientApp" Command="npm ci --no-audit --no-fund" />
  </Target>
  <Target Name="BuildClient" BeforeTargets="PrepareForBuild" DependsOnTargets="RestoreClient" Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipClientBuild)' != 'true'">
    <Exec WorkingDirectory="ClientApp" Command="npm run build" />
    <ItemGroup>
      <Content Remove="wwwroot/**/*" />
      <Content Include="wwwroot/**/*" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
